NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: canonical site URL for auth redirects (magic link / confirmations). Defaults to the browser origin when unset.
NEXT_PUBLIC_SITE_URL=
# Secret from Supabase Dashboard → Authentication → Hooks (Send Email hook → Edge Function auth-send-email).
SEND_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=runion <hello@runion.app>
WHATSAPP_PROVIDER=360dialog
WHATSAPP_API_KEY=
WHATSAPP_NAMESPACE=
NEXT_PUBLIC_DEFAULT_CITY=bcn

# Map basemap. Set a free CARTO key (carto.com/basemaps/apikey) to get the
# near-black dark_all tiles; without it the map falls back to Esri's keyless
# (greyer) dark basemap so it still renders. NEXT_PUBLIC_MAP_TILE_URL is an
# optional full tile template that overrides both if CARTO's URL format changes.
NEXT_PUBLIC_CARTO_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
